{
  "name": "lyria-studio",
  "version": "0.1.3",
  "description": "Music IDE powered by Google Lyria Realtime",
  "main": "dist-electron/main.js",
  "scripts": {
    "postinstall": "node scripts/patch-dev-name.mjs",
    "dev": "node scripts/patch-dev-name.mjs && tsc -p tsconfig.node.json && concurrently -k \"vite --port 5173\" \"tsc -p tsconfig.node.json -w\" \"VITE_DEV_SERVER_URL=http://localhost:5173 wait-on http://localhost:5173 && VITE_DEV_SERVER_URL=http://localhost:5173 NODE_ENV=development electron .\"",
    "icons": "node scripts/generate-icons.mjs",
    "build": "npm run icons && vite build && tsc -p tsconfig.node.json",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@google/genai": "^1.49.0",
    "@xyflow/react": "^12.3.6",
    "electron-updater": "^6.8.3",
    "lucide-react": "^1.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^11.0.3",
    "ws": "^8.18.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  }
}
